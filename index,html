function sfxThud(){ if(!AC||muted) return; const t=AC.currentTime;
  const o=AC.createOscillator(), g=AC.createGain(); o.type='sine';
  o.frequency.setValueAtTime(64,t); o.frequency.exponentialRampToValueAtTime(30,t+.22);
