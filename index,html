function makeLimb(cfg){
  const limb = {
    id: cfg.id, ru: cfg.ru, root: cfg.root, threshold: cfg.thr,
    axis: cfg.axis, tipExtent: cfg.tipExtent, reach: Math.abs(cfg.tipExtent),
    groundR: cfg.groundR, twistFix: !!cfg.twist, attached: true, dragging: false,
    stretch: 1, sVel: 0, stretchTarget: 1, phase: rnd(0,6), swayAmp: cfg.sway,
    bendNodes: cfg.bends, socketLocal: cfg.root.position.clone(), fly: null,
    meshes: [], snapT: 0, snapFrom: null, curDir: null, throwV: V3(0,0,0),
  };
  limb.restQuat = cfg.restQuat.clone();
  limb.root.rotationQuaternion = cfg.restQuat.clone();
  limb.root.getDescendants(false).forEach(n=>{
    if(n instanceof BABYLON.Mesh){ limb.meshes.push(n); pickMap.set(n, limb); n.isPickable = true; }
  });
  /* невидимая, но ПИКАЕМАЯ зона захвата: visibility=0 */
  const helper = BABYLON.MeshBuilder.CreateSphere('pick',{diameter:cfg.pickR},scene);
  helper.parent = cfg.pickParent; helper.position.copyFrom(cfg.pickPos);
  helper.visibility = 0; helper.isPickable = true; helper.__pickHelper = true;
  pickMap.set(helper, limb); limb.meshes.push(helper);
  /* «рана» на месте отрыва */
  const cap = new BABYLON.TransformNode('cap',scene);
  cap.parent = cowboy; cap.position.copyFrom(limb.socketLocal);
  cap.rotationQuaternion = cfg.restQuat.clone();
  const cTor = BABYLON.MeshBuilder.CreateTorus('capT',{diameter:cfg.capR*2,thickness:.018,tessellation:16},scene);
  cTor.parent=cap; cTor.material=MAT.stitch; cTor.isPickable=false;
  for(let i=0;i<3;i++){ const f = BABYLON.MeshBuilder.CreateSphere('capF',{diameter:cfg.capR*rnd(1.1,1.7),segments:7},scene);
    f.parent=cap; f.position.set(rnd(-.03,.03), -.015-i*.012, rnd(-.03,.03)); f.material=MAT.cotton; f.isPickable=false; }
  cap.setEnabled(false);
  limb.cap=cap;
  limbs.push(limb); return limb;
}
