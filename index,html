function strut(a, b, r, material, parent){
  const dir = b.subtract(a);
  const len = dir.length();
  if(len < 1e-5) return null;
  const m = BABYLON.MeshBuilder.CreateCapsule('st'+Math.random(),
    {height:len, radius:r, capSubdivisions:3, tessellation:10}, scene);
  m.material = material;
  if(parent) m.parent = parent;
  m.position.copyFrom(a.add(b).scale(.5));
  m.rotationQuaternion = rotFromTo(UP, dir.scale(1/len));
  m.isPickable=false; m.receiveShadows=true; shGen.addShadowCaster(m);
  return m;
}
function ball(d, pos, material, parent, s){
  const m = BABYLON.MeshBuilder.CreateSphere('bl'+Math.random(), {diameter:d, segments:10}, scene);
  m.material = material;
  if(parent) m.parent = parent;
  m.position.copyFrom(pos);
  if(s) m.scaling.set(s[0],s[1],s[2]);
  m.isPickable=false; m.receiveShadows=true; shGen.addShadowCaster(m);
  return m;
}

