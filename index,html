/* ---------- оружие игрока: стрельба, трассеры, вспышки ---------- */
const bulletM = new BABYLON.StandardMaterial('bulletM',scene);
bulletM.emissiveColor = new BABYLON.Color3(1,.82,.35);
bulletM.diffuseColor = BABYLON.Color3.Black();
bulletM.disableLighting = true;
const flashM = new BABYLON.StandardMaterial('flashM',scene);
flashM.emissiveColor = new BABYLON.Color3(1,.87,.4);
flashM.diffuseColor = BABYLON.Color3.Black();
flashM.disableLighting = true;
const tracers=[], flashes=[];
const flashLight = new BABYLON.PointLight('flashLight', V3(0,0,0), scene);
flashLight.diffuse = new BABYLON.Color3(1,.8,.4);
flashLight.intensity = 0; flashLight.range = 4;
flashLight.setEnabled(false);

function spawnTracer(a, b){
  const dir=b.subtract(a); const len=dir.length();
  if(len<1e-4) return;
  const m=BABYLON.MeshBuilder.CreateCapsule('bullet',{height:.26,radius:.011,tessellation:6,capSubdivisions:2},scene);
  m.material=bulletM; m.isPickable=false;
  m.position.copyFrom(a);
  m.rotationQuaternion=rotFromTo(UP, dir.scale(1/len));
  tracers.push({m,a:a.clone(),b:b.clone(),len,t:0});
}
function muzzleFlash(p){
  const m=BABYLON.MeshBuilder.CreateSphere('fl',{diameter:.15,segments:6},scene);
  m.material=flashM; m.isPickable=false; m.renderingGroupId=1; m.position.copyFrom(p);
  flashes.push({m,t:0});
}
function fire(px, py){
  if(reloading>0) return;
  if(ammo<=0){ sfxDry(); return; }
  if(time-lastShot<.34) return;
  lastShot=time; ammo--; updAmmo();
  wakeAudio(); introT=99; idleT=0;
  stat.shots++; updStats();

  muzzleNode.computeWorldMatrix(true);
  const from = muzzleNode.getAbsolutePosition();

  /* попадание — мгновенный луч из камеры через курсор; трассер — визуал */
  const pick = scene.pick(px, py, m=>pickMap.has(m)||bodyMeshes.has(m));
  let to, hitMesh=null;
  if(pick && pick.hit && pick.pickedMesh){
    hitMesh = pick.pickedMesh; to = pick.pickedPoint;
  } else {
    const ray = scene.createPickingRay(px, py, null, camera);
    to = ray.origin.add(ray.direction.scale(30));
    const gp = scene.pick(px, py, m=>m===ground);
    if(gp && gp.hit){ to = gp.pickedPoint; dustBurst(to); }
  }
  const dir = to.subtract(from); const len = dir.length();
  if(len>1e-4) dir.scaleInPlace(1/len);

  spawnTracer(from, to);
  muzzleFlash(from);
  sfxShot();
  recoilT = 1; drumSpinT = .3;
  flashLight.setEnabled(true);
  flashLight.position.copyFrom(from);
  flashLight.intensity = 2.4; flashT = .07;

  if(hitMesh){
    stat.hits++; updStats();
    if(pickMap.has(hitMesh)){
      const limb = pickMap.get(hitMesh);
      if(limb.attached){
        tear(limb, dir);           /* отстрел: деталь улетает по ходу пули */
        shotBurst(to);
      } else {
        if(!limb.fly) limb.fly={ v:V3(0,0,0), av:V3(0,0,0) };
        limb.fly.v.addInPlace(dir.scale(3.2));
        limb.fly.v.y=Math.max(limb.fly.v.y,1.4);
        limb.fly.av.set(rnd(-5,5),rnd(-5,5),rnd(-5,5));
        shotBurst(to); sfxHit();
      }
    } else if(bodyMeshes.has(hitMesh)){
      damageJoe(12);
      shotBurst(to); sfxHit();
      shake=Math.max(shake,.3);
    }
  }
}
function reload(){
  if(ammo>=6 || reloading>0) return;
  reloading=.9;
