<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<title>Тяни ковбоя! — интерактивная кукла</title>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Yeseva+One&family=PT+Sans:wght@400;700&display=swap" rel="stylesheet">
<style>
  :root{ --gold:#d9a441; --cream:#f2e3c2; --leather:#2a1a0e; --red:#b0392b; }
  *{ box-sizing:border-box; margin:0; padding:0; }
  html,body{ height:100%; overflow:hidden; background:#e9d3a6; font-family:'PT Sans',sans-serif; color:var(--cream); }
  #renderCanvas{ width:100%; height:100%; display:block; touch-action:none; outline:none; cursor:crosshair; }
  #vignette{ position:fixed; inset:0; pointer-events:none; z-index:3;
    background: radial-gradient(ellipse at center, transparent 55%, rgba(40,22,8,.42) 100%); }
  .hud{ position:fixed; z-index:10; animation:fadein .9s ease both; }
  @keyframes fadein{ from{opacity:0; transform:translateY(8px);} to{opacity:1; transform:none;} }
  @keyframes blinkA{ 50%{opacity:.35;} }

  .poster{ top:18px; left:18px; width:308px; padding:18px 20px 16px;
    background: linear-gradient(160deg,#33200f 0%, #241407 60%, #2c1a0b 100%);
    border:3px solid var(--gold); outline:2px solid #17100a; outline-offset:-8px;
    border-radius:6px; box-shadow:0 14px 40px rgba(30,15,0,.45), inset 0 0 46px rgba(0,0,0,.5); }
  .poster .wanted{ font-size:11px; letter-spacing:.5em; color:var(--gold); text-align:center; margin-bottom:6px; }
  .poster h1{ font-family:'Yeseva One',serif; font-weight:400; text-align:center; line-height:.95;
    color:var(--cream); text-shadow:0 3px 0 rgba(0,0,0,.5); }
  .poster h1 .l1{ display:block; font-size:30px; letter-spacing:.14em; }
  .poster h1 .l2{ display:block; font-size:44px; color:var(--gold); }
  .poster .tag{ text-align:center; font-size:12px; font-style:italic; opacity:.75; margin:7px 0 11px; }
  .poster ul{ list-style:none; font-size:13.5px; line-height:1.45; }
  .poster li{ padding:3px 0 3px 20px; position:relative; }
  .poster li::before{ content:'★'; position:absolute; left:0; color:var(--gold); font-size:11px; top:6px; }
  .poster li b{ color:#ffd98a; }
  .keys{ display:flex; gap:6px; flex-wrap:wrap; margin-top:12px; }
  .keys span{ font-size:10.5px; letter-spacing:.04em; border:1px solid #6a4a22; border-radius:3px;
    padding:3px 7px; color:#e8cf9d; background:rgba(0,0,0,.25); }

  .topright{ top:18px; right:18px; text-align:right; }
  .btns{ display:flex; gap:8px; justify-content:flex-end; }
  .btns button{ pointer-events:auto; cursor:pointer; font-family:'PT Sans',sans-serif; font-weight:700;
    font-size:13px; color:var(--cream); background:linear-gradient(#3c2412,#241407);
    border:2px solid var(--gold); border-radius:5px; padding:8px 13px;
    box-shadow:0 4px 12px rgba(20,10,0,.4); transition:transform .15s, box-shadow .15s, background .15s; }
  .btns button:hover{ transform:translateY(-2px); box-shadow:0 8px 18px rgba(20,10,0,.5); background:linear-gradient(#4a2d15,#2a1808); }
  .btns button:active{ transform:translateY(0); }
  .btns #btnMute{ padding:8px 10px; font-size:15px; line-height:1; }
  .stats{ margin-top:9px; font-size:12px; letter-spacing:.06em; color:#e8cf9d; opacity:.9; }
  .stats b{ color:var(--gold); }

  .hprow{ display:flex; align-items:center; gap:8px; margin-top:9px; justify-content:flex-end; }
  .hplbl{ font-size:10.5px; letter-spacing:.12em; text-transform:uppercase; color:#e8cf9d; }
  .hptrack{ width:140px; height:12px; border:2px solid var(--gold); border-radius:7px;
    background:rgba(20,10,0,.55); overflow:hidden; }
  #hpfill{ height:100%; width:100%; border-radius:4px; transition:width .25s, background .3s;
    background:linear-gradient(90deg,#7fc25a,#a8c84f); }
  #hpfill.low{ background:linear-gradient(90deg,#d9a441,#e0762e); }
  #hpfill.crit{ background:linear-gradient(90deg,#e0512e,#b0392b); animation:blinkA .5s infinite; }
  .mood{ margin-top:7px; font-size:12.5px; font-style:italic; color:#ffd98a; min-height:17px; }

  .chips{ left:18px; bottom:18px; display:flex; gap:7px; flex-wrap:wrap; max-width:70vw; }
  .chip{ font-size:12px; font-weight:700; letter-spacing:.03em; padding:6px 11px 6px 24px; position:relative;
    background:#241407; border:1.5px solid #6a4a22; border-radius:20px; transition:all .25s; }
  .chip i{ position:absolute; left:9px; top:50%; width:9px; height:9px; border-radius:50%;
    transform:translateY(-50%); background:#7fc25a; box-shadow:0 0 7px #7fc25a88; transition:all .25s; }
  .chip.torn{ border-color:var(--red); color:#f0b1a5; text-decoration:line-through; cursor:pointer; pointer-events:auto; }
  .chip.torn i{ background:var(--red); box-shadow:0 0 9px #b0392baa; }
  .chip.torn:hover{ background:#3a150e; transform:translateY(-2px); }

  .tension{ left:50%; bottom:26px; transform:translateX(-50%); width:290px; display:none; text-align:center; }
  .tension .tlabel{ font-size:12px; font-weight:700; letter-spacing:.14em; color:var(--cream);
    text-shadow:0 2px 4px rgba(0,0,0,.6); margin-bottom:6px; }
  .tension .track{ height:15px; border:2px solid var(--gold); border-radius:9px; background:rgba(20,10,0,.55);
    overflow:hidden; box-shadow:0 4px 14px rgba(20,10,0,.45); }
  .tension #tfill{ height:100%; width:0%; border-radius:6px; transition:background .2s; background:linear-gradient(90deg,#7fc25a,#c8d24f); }
  .tension.warn #tfill{ background:linear-gradient(90deg,#d9a441,#e0762e); }
  .tension.danger #tfill{ background:linear-gradient(90deg,#e0512e,#b0392b); }
  .tension.danger{ animation:jitter .12s infinite; }
  @keyframes jitter{ 0%{transform:translateX(calc(-50% - 2px));} 50%{transform:translateX(calc(-50% + 2px));} }

  .ammo{ position:fixed; left:50%; bottom:70px; transform:translateX(-50%); z-index:9;
    display:flex; gap:5px; pointer-events:none; }
  .ammo .bullet{ width:8px; height:20px; border-radius:3px 3px 2px 2px;
    background:linear-gradient(180deg,#e8b24a,#9a6a26); box-shadow:0 1px 3px rgba(0,0,0,.45); }
  .ammo .bullet.spent{ background:linear-gradient(180deg,#3a2a1c,#241a10); box-shadow:none; }
  .reloadHint{ position:fixed; left:50%; bottom:98px; transform:translateX(-50%); z-index:9;
    font-size:12px; font-weight:700; letter-spacing:.12em; color:#ffd98a;
    text-shadow:0 1px 3px rgba(0,0,0,.65); pointer-events:none; display:none; }
  .reloadHint.show{ display:block; animation:blinkA .7s infinite; }

  .credit{ right:18px; bottom:16px; font-size:11px; letter-spacing:.08em; color:#7a5a30; }

  @media (max-width:700px){
    .poster{ width:230px; padding:12px 14px; }
    .poster h1 .l2{ font-size:32px; } .poster ul{ display:none; }
    .chips{ max-width:56vw; } .credit{ display:none; }
    .stats{ font-size:10.5px; }
    .ammo{ bottom:60px; } .reloadHint{ bottom:86px; }
  }
</style>
</head>
<body>
<canvas id="renderCanvas"></canvas>
<div id="vignette"></div>

<div class="hud poster">
  <div class="wanted">★ WANTED ★</div>
  <h1><span class="l1">ТЯНИ</span><span class="l2">КОВБОЯ!</span></h1>
  <div class="tag">резиновый Джо к вашим услугам</div>
  <ul>
    <li><b>Хватай</b> руку, ногу или голову и тяни в сторону</li>
    <li><b>Перетянешь</b> — оторвётся с треском и улетит</li>
    <li><b>Стреляй</b> из револьвера: отстреливай части, изрешети торс</li>
    <li><b>Лечи</b>: каждая пришитая деталь возвращает 20 здоровья</li>
    <li><b>Без ноги</b> или при нуле здоровья Джо падает — заштопай и он встанет</li>
  </ul>
  <div class="keys"><span>🖱 ЛКМ тянуть</span><span>🔫 ПКМ стрелять</span><span>R перезарядка</span><span>F огонь</span><span>↔ камера</span><span>⚙ зум</span></div>
</div>

<div class="hud topright">
  <div class="btns">
    <button id="btnFire">🔫 Огонь</button>
    <button id="btnSew">🪡 Пришить всё</button>
    <button id="btnReset">↺ Сначала</button>
    <button id="btnMute" title="Звук">🔊</button>
  </div>
  <div class="stats" id="stats">рывков <b>0</b> · оторвано <b>0</b> · пришито <b>0</b> · выстрелов <b>0</b> · в цель <b>0</b></div>
  <div class="hprow"><span class="hplbl">здоровье</span>
    <div class="hptrack"><div id="hpfill"></div></div></div>
  <div class="mood" id="mood">Джо в отличной форме</div>
</div>

<div class="hud chips" id="chips"></div>

<div class="hud tension" id="tension">
  <div class="tlabel" id="tlabel"></div>
  <div class="track"><div id="tfill"></div></div>
</div>

<div class="ammo" id="ammo"></div>
<div class="reloadHint" id="reloadHint">R — ПЕРЕЗАРЯДКА</div>

<div class="hud credit">у костра Билл жарит сосиску · ЛКМ тянуть · ПКМ стрелять · R перезарядка</div>

<script src="https://cdn.babylonjs.com/babylon.js"></script>
<script>
"use strict";
const canvas = document.getElementById('renderCanvas');
const engine = new BABYLON.Engine(canvas, true, { stencil:true, antialias:true });
const scene  = new BABYLON.Scene(engine);
scene.clearColor = new BABYLON.Color4(0.93, 0.83, 0.65, 1);
scene.fogMode = BABYLON.Scene.FOGMODE_EXP2;
scene.fogDensity = 0.016;
scene.fogColor = new BABYLON.Color3(0.92, 0.82, 0.63);

const V3 = (x,y,z)=>new BABYLON.Vector3(x,y,z);
const DOWN = V3(0,-1,0), UP = V3(0,1,0), FWD = V3(0,0,1);
const clamp = (v,a,b)=>Math.min(b,Math.max(a,v));
const rnd = (a,b)=>a+Math.random()*(b-a);

/* «поворот от вектора к вектору» — Quaternion.RotationFromTo в Babylon.js НЕТ */
function rotFromTo(from, to){
  const d = clamp(BABYLON.Vector3.Dot(from, to), -1, 1);
  if (d > 1 - 1e-9) return new BABYLON.Quaternion(0,0,0,1);
  if (d < -1 + 1e-9){
    let ax = V3(1,0,0);
    if (Math.abs(from.x) > .9) ax = V3(0,1,0);
    const perp = BABYLON.Vector3.Cross(from, ax); perp.normalize();
    return BABYLON.Quaternion.RotationAxis(perp, Math.PI);
  }
  const axis = BABYLON.Vector3.Cross(from, to); axis.normalize();
  return BABYLON.Quaternion.RotationAxis(axis, Math.acos(d));
}

/* ---------- общее изменяемое состояние (объявлено ОДИН раз, до всех функций) ---------- */
let drag=null, hoverLimb=null, lastHover=0;
let idleT=0, shake=0, time=0, introT=0, blinkT=0, blinkNext=2.5, shockT=0, focusT=0, focusPos=null;
let hintOn=false, dragPlane=null;
const dragTarget=V3(0,0,0), lean=V3(0,0,0), _scr=V3(0,0,0);
/* оружие игрока */
let ammo=6, reloading=0, lastShot=-9, recoilT=0, drumSpinT=0, flashT=0;

/* ---------- камера / свет ---------- */
const camera = new BABYLON.ArcRotateCamera('cam', Math.PI/2, 1.18, 8.5, V3(0,1.02,0), scene);
camera.attachControl(canvas, true);
scene.attachControl();
camera.lowerRadiusLimit = 2.4; camera.upperRadiusLimit = 11;
camera.lowerBetaLimit = 0.35;  camera.upperBetaLimit = 1.55;
camera.wheelDeltaPercentage = 0.012; camera.pinchDeltaPercentage = 0.012;
camera.panningSensibility = 0;

const hemi = new BABYLON.HemisphericLight('hemi', V3(0,1,0), scene);
hemi.intensity = 0.55; hemi.diffuse = new BABYLON.Color3(.9,.92,1);
hemi.groundColor = new BABYLON.Color3(.58,.46,.3);

const sun = new BABYLON.DirectionalLight('sun', V3(-0.55,-0.72,0.42), scene);
sun.intensity = 1.15; sun.diffuse = new BABYLON.Color3(1,.94,.82);
sun.position = V3(14,20,-10);
sun.autoCalcShadowZBounds = true;
const shGen = new BABYLON.ShadowGenerator(1024, sun);
shGen.useBlurExponentialShadowMap = true; shGen.blurKernel = 16; shGen.setDarkness(0.35);

const glow = new BABYLON.GlowLayer('glow', scene); glow.intensity = 0.45;
const hl = new BABYLON.HighlightLayer('hl', scene, { blurHorizontalSize:1, blurVerticalSize:1 });

/* ---------- материалы ---------- */
function tex(draw, w=256, h=256){
  const t = new BABYLON.DynamicTexture('t'+Math.random(), {width:w,height:h}, scene, true);
  draw(t.getContext(), w, h); t.update(); return t;
}
const plaidTex = tex((c,w,h)=>{ c.fillStyle='#a5402c'; c.fillRect(0,0,w,h);
  c.fillStyle='#7d2b20'; for(let i=0;i<w;i+=64){ c.fillRect(i,0,14,h); c.fillRect(0,i,w,14);}
  c.fillStyle='#d9c08a'; for(let i=22;i<w;i+=64){ c.fillRect(i,0,3,h); c.fillRect(0,i,w,3);} });
plaidTex.uScale = plaidTex.vScale = 2.5;
const denimTex = tex((c,w,h)=>{ c.fillStyle='#3d5878'; c.fillRect(0,0,w,h);
  for(let i=0;i<2600;i++){ c.fillStyle = Math.random()<.5?'rgba(255,255,255,.07)':'rgba(0,0,20,.10)';
    c.fillRect(Math.random()*w, Math.random()*h, 1.5, 1.5);} });
denimTex.uScale = denimTex.vScale = 2;
const sandTex = tex((c,w,h)=>{ c.fillStyle='#d5ae7e'; c.fillRect(0,0,w,h);
  for(let i=0;i<5000;i++){ c.fillStyle = Math.random()<.5?'rgba(160,120,70,.25)':'rgba(240,215,170,.3)';
    c.fillRect(Math.random()*w, Math.random()*h, rnd(1,2.4), rnd(1,2.4)); }
  for(let i=0;i<14;i++){ const x=Math.random()*w,y=Math.random()*h,r=rnd(20,60);
    const g=c.createRadialGradient(x,y,0,x,y,r); g.addColorStop(0,'rgba(140,100,55,.10)'); g.addColorStop(1,'transparent');
    c.fillStyle=g; c.fillRect(x-r,y-r,r*2,r*2);} }, 512, 512);
sandTex.uScale = sandTex.vScale = 6;

function mat(name, color, o={}){
  const m = new BABYLON.StandardMaterial(name, scene);
  m.diffuseColor = BABYLON.Color3.FromHexString(color);
  m.specularColor = new BABYLON.Color3(o.spec??.08, o.spec??.08, o.spec??.08);
  m.specularPower = o.power ?? 48;
  if(o.tex) m.diffuseTexture = o.tex;
  if(o.emissive) m.emissiveColor = BABYLON.Color3.FromHexString(o.emissive);
  return m;
}
const MAT = {
  skin: mat('skin','#d8955e',{spec:.12}), shirt: mat('shirt','#a5402c',{tex:plaidTex}),
  vest: mat('vest','#4f331c',{spec:.14}), pants: mat('pants','#3d5878',{tex:denimTex}),
  boot: mat('boot','#6b4423',{spec:.2,power:64}), sole: mat('sole','#332214'),
  hat: mat('hat','#b8894f'), hatband: mat('hatband','#4a2c15'),
  bandana: mat('bandana','#b23a2e',{spec:.15}), belt: mat('belt','#3f2713'),
  buckle: mat('buckle','#d9a441',{spec:.6,power:96,emissive:'#5a3f10'}),
  metal: mat('metal','#9a9a9a',{spec:.7,power:96}), wood: mat('wood','#6d4a2a'),
  cactus: mat('cactus','#56804b',{spec:.05}), rock: mat('rock','#8d7a66'),
  cotton: mat('cotton','#f2e8d5'), stitch: mat('stitch','#7a2d22'),
  hair: mat('hair','#4a2f1a'), dark: mat('dark','#2a1c12'),
  white: mat('white','#f5f0e6',{spec:.3}),
};

/* ---------- небо и земля ---------- */
const skyTex = tex((c,w,h)=>{
  const g = c.createLinearGradient(0,0,0,h);
  g.addColorStop(0,'#4d84bd'); g.addColorStop(.42,'#9dc0d4');
  g.addColorStop(.5,'#f0dcae'); g.addColorStop(1,'#f0dcae');
  c.fillStyle=g; c.fillRect(0,0,w,h); }, 8, 256);
const sky = BABYLON.MeshBuilder.CreateSphere('sky',{diameter:170,sideOrientation:BABYLON.Mesh.BACKSIDE},scene);
{ const m = new BABYLON.StandardMaterial('skyM',scene);
  m.emissiveTexture = skyTex; m.disableLighting = true; m.fogEnabled = false;
  sky.material = m; sky.isPickable = false; glow.addExcludedMesh(sky); }

const ground = BABYLON.MeshBuilder.CreateGround('ground',{width:70,height:70,subdivisions:64},scene);
{ const pos = ground.getVerticesData(BABYLON.VertexBuffer.PositionKind);
  for(let i=0;i<pos.length;i+=3){ const x=pos[i],z=pos[i+2],d=Math.hypot(x,z);
    const f = clamp((d-4)/7,0,1);
    pos[i+1] += (Math.sin(x*.33)*Math.cos(z*.27)*.4 + Math.sin(x*.11+z*.17)*.55)*f; }
  ground.updateVerticesData(BABYLON.VertexBuffer.PositionKind,pos); ground.createNormals(false); }
ground.material = mat('gnd','#d5ae7e',{tex:sandTex});
ground.receiveShadows = true;
ground.isPickable = true; /* фонтанчик пыли при промахе */

const sunBall = BABYLON.MeshBuilder.CreateSphere('sunBall',{diameter:5},scene);
sunBall.position = V3(26,16,-34);
{ const m = new BABYLON.StandardMaterial('sunM',scene);
  m.emissiveColor = new BABYLON.Color3(1,.9,.65); m.disableLighting = true; m.fogEnabled=false;
  sunBall.material = m; sunBall.isPickable=false; }

/* ---------- текстура частиц (ОБЩАЯ — dispose(false)!) ---------- */
const flare = new BABYLON.DynamicTexture('flare',64,scene,true);
{ const c=flare.getContext(); const g=c.createRadialGradient(32,32,2,32,32,30);
  g.addColorStop(0,'rgba(255,255,255,1)'); g.addColorStop(.5,'rgba(255,255,255,.55)'); g.addColorStop(1,'rgba(255,255,255,0)');
  c.fillStyle=g; c.fillRect(0,0,64,64); flare.update(); flare.hasAlpha = true; }

function burst(pos, opt){
  const ps = new BABYLON.ParticleSystem('b', opt.count, scene);
  ps.particleTexture = flare; ps.emitter = pos.clone(); ps.manualEmitCount = opt.count;
  ps.emitRate = 0;
  ps.minLifeTime = opt.life*.6; ps.maxLifeTime = opt.life;
  ps.minSize = opt.s*.6; ps.maxSize = opt.s;
  ps.color1 = opt.color; ps.color2 = opt.color; ps.colorDead = new BABYLON.Color4(opt.color.r,opt.color.g,opt.color.b,0);
  ps.direction1 = V3(-1,-0.2,-1).scale(opt.spread); ps.direction2 = V3(1,1.2,1).scale(opt.spread);
  ps.minEmitPower = opt.pw*.5; ps.maxEmitPower = opt.pw;
  ps.gravity = V3(0, opt.grav ?? -3, 0);
  ps.blendMode = BABYLON.ParticleSystem.BLENDMODE_STANDARD;
  ps.updateSpeed = 0.016; ps.targetStopDuration = opt.life+.4;
  ps.start();
  setTimeout(()=>{ try{ ps.dispose(false); }catch(e){} }, Math.ceil((opt.life+.8)*1000));
}
const puffBurst  = p=>burst(p,{count:26,life:.8,s:.15,color:new BABYLON.Color4(.96,.93,.86,.95),spread:.9,pw:1.6,grav:-2.5});
const sewBurst   = p=>burst(p,{count:16,life:.5,s:.05,color:new BABYLON.Color4(1,.85,.4,.9),spread:.5,pw:1.2,grav:-1});
const dustBurst  = p=>burst(p,{count:12,life:.5,s:.12,color:new BABYLON.Color4(.85,.72,.5,.9),spread:.6,pw:1,grav:-3});
const shotBurst  = p=>burst(p,{count:10,life:.35,s:.08,color:new BABYLON.Color4(.9,.35,.2,.9),spread:.5,pw:1.4,grav:-2});
const greasePop  = p=>burst(p,{count:4,life:.3,s:.035,color:new BABYLON.Color4(1,.6,.2,.9),spread:.25,pw:.5,grav:-2});

{ const ps = new BABYLON.ParticleSystem('dust',120,scene);
  ps.particleTexture = flare; ps.emitter = V3(0,0,0); ps.emitRate = 9;
  ps.minEmitBox = V3(-13,0,-13); ps.maxEmitBox = V3(13,2.5,13);
  ps.minLifeTime = 5; ps.maxLifeTime = 9; ps.minSize = .02; ps.maxSize = .05;
  ps.color1 = new BABYLON.Color4(.9,.8,.65,.10); ps.color2 = new BABYLON.Color4(.85,.75,.6,.06);
  ps.colorDead = new BABYLON.Color4(.9,.8,.65,0);
  ps.direction1 = V3(.02,.03,.01); ps.direction2 = V3(.06,.06,.03);
  ps.minEmitPower=.15; ps.maxEmitPower=.4; ps.gravity=V3(0,.01,0);
  ps.blendMode = BABYLON.ParticleSystem.BLENDMODE_STANDARD; ps.start(); }

/* ---------- декорации ---------- */
function deco(m){ m.isPickable=false; return m; }
function cactus(x,z,h){
  const g = new BABYLON.TransformNode('c',scene); g.position.set(x,0,z);
  const trunk = deco(BABYLON.MeshBuilder.CreateCapsule('ct',{height:h,radius:h*.14},scene));
  trunk.parent=g; trunk.position.y=h/2; trunk.material=MAT.cactus; shGen.addShadowCaster(trunk);
  for(const s of [-1,1]){
    const arm = deco(BABYLON.MeshBuilder.CreateCapsule('ca',{height:h*.42,radius:h*.085},scene));
    arm.parent=g; arm.material=MAT.cactus;
