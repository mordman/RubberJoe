  reloadHintEl.classList.remove('show');
}

/* ---------- ввод ---------- */
const HOVER_C=new BABYLON.Color3(1,.78,.28), HINT_C=new BABYLON.Color3(1,.84,.42);

function setHint(on){
  if(hintOn===on) return;
  hintOn=on;
  limbs.forEach(l=>l.meshes.forEach(m=>{ if(!m.__pickHelper){ on?hl.addMesh(m,HINT_C):hl.removeMesh(m);} }));
}
function reattachCamera(){
  camera.detachControl();
  camera.attachControl(canvas, true);
}
function screenToWorld(){
  const ray = scene.createPickingRay(scene.pointerX, scene.pointerY, null, camera);
  const t = ray.intersectsPlane(dragPlane);
  return (t==null||t<0)? null : ray.origin.add(ray.direction.scale(t));
}
function setHover(limb){
  if(hoverLimb===limb) return;
  setHint(false);
  if(hoverLimb) hoverLimb.meshes.forEach(m=>hl.removeMesh(m));
  hoverLimb=limb;
  if(limb) limb.meshes.forEach(m=>{ if(!m.__pickHelper) hl.addMesh(m, HOVER_C); });
  canvas.style.cursor = limb ? 'grab' : 'crosshair';
}
function startDrag(limb, point, ev){
  if(!limb) return;
  drag=limb; limb.dragging=true; stat.pulls++; updStats(); idleT=0; introT=99;
  limb.root.computeWorldMatrix(true);
  const inv=BABYLON.Matrix.Identity();
  limb.root.getWorldMatrix().invertToRef(inv);
  limb.grabOffsetLocal = BABYLON.Vector3.TransformCoordinates(point, inv);
  dragPlane = BABYLON.Plane.FromPositionAndNormal(point, camera.position.subtract(point).normalize());
  dragTarget.copyFrom(point);
  camera.detachControl(); canvas.style.cursor='grabbing';
  if(ev && ev.pointerId!==undefined){ try{ canvas.setPointerCapture(ev.pointerId); }catch(e){} }
  if(limb.attached){
    creakStart();
    tensionEl.style.display='block'; tensionEl.className='hud tension'; tFill.style.width='0%';
    tLabel.textContent=limb.ru.toUpperCase();
  }
  setHover(null);
}
function endDrag(){
  if(!drag) return;
  const l=drag;
  l.dragging=false;
  if(!l.attached){ /* бросок: передаём детали скорость руки */
    if(!l.fly) l.fly={ v:V3(0,0,0), av:V3(0,0,0) };
    l.fly.v.copyFrom(l.throwV);
    if(l.fly.v.length()>7) l.fly.v.scaleInPlace(7/l.fly.v.length());
    l.fly.v.y=Math.max(l.fly.v.y,.4);
    l.fly.av.set(rnd(-3,3),rnd(-3,3),rnd(-3,3));
  }
  drag=null; creakStop(); tensionEl.style.display='none';
  reattachCamera();
  canvas.style.cursor='crosshair';
}
scene.onPointerObservable.add(pi=>{
  idleT=0;
  const ev = pi.input;
  if(pi.type===BABYLON.PointerEventTypes.POINTERDOWN){
    wakeAudio(); introT=99;
    let px=scene.pointerX, py=scene.pointerY;
    if(ev && ev.clientX!==undefined){
      const r=canvas.getBoundingClientRect();
      px=ev.clientX-r.left; py=ev.clientY-r.top;
    }
    if(ev && ev.pointerType!=='touch' && ev.button===2){ fire(px,py); return; } /* ПКМ — выстрел */
    if(ev && ev.pointerType!=='touch' && ev.button!==0) return;                  /* ЛКМ — тянет */
    const pr = scene.pick(px, py, m=>pickMap.has(m));
    if(pr && pr.hit && pr.pickedMesh){
      const limb = pickMap.get(pr.pickedMesh);
      if(limb){
        if(ev && ev.preventDefault) ev.preventDefault();
        startDrag(limb, pr.pickedPoint, ev);
      }
    }
  } else if(pi.type===BABYLON.PointerEventTypes.POINTERMOVE){
    if(drag){ const p=screenToWorld(); if(p){ p.y=Math.max(p.y,.03); dragTarget.copyFrom(p); } }
    else { const now=performance.now();
      if(now-lastHover>40){ lastHover=now;
        const pr = scene.pick(scene.pointerX, scene.pointerY, m=>pickMap.has(m));
        const limb = (pr && pr.hit && pr.pickedMesh) ? pickMap.get(pr.pickedMesh) : null;
        setHover(limb || null); } }
  } else if(pi.type===BABYLON.PointerEventTypes.POINTERUP || pi.type===BABYLON.PointerEventTypes.POINTEROUT){
    endDrag();
  }
});
window.addEventListener('keydown', e=>{
  if(e.code==='KeyF') fire(scene.pointerX, scene.pointerY);
  else if(e.code==='KeyR') reload();
});
canvas.addEventListener('contextmenu', e=>e.preventDefault());
window.addEventListener('blur',()=>endDrag());
canvas.addEventListener('wheel',()=>idleT=0);

/* ---------- логика конечностей ---------- */
function aimQuat(dir, twist, axis){
  let q = rotFromTo(axis, dir);
  if(twist){
    const m = BABYLON.Matrix.Identity();
    BABYLON.Matrix.FromQuaternionToRef(q, m);
    const fwd = BABYLON.Vector3.TransformCoordinates(FWD, m);
    const f1 = fwd.subtract(dir.scale(BABYLON.Vector3.Dot(fwd,dir)));
    if(f1.lengthSquared()>1e-6){
      f1.normalize();
      const d1 = FWD.subtract(dir.scale(BABYLON.Vector3.Dot(FWD,dir)));
      if(d1.lengthSquared()>.04){
        d1.normalize();
        const ang = Math.atan2(BABYLON.Vector3.Dot(BABYLON.Vector3.Cross(f1,d1),dir), BABYLON.Vector3.Dot(f1,d1));
        q = BABYLON.Quaternion.RotationAxis(dir, ang).multiply(q);
      }
    }
  }
  return q;
}
function tear(limb, dir){
  limb.attached=false; limb.dragging=false; limb.stretchTarget=1;
  if(drag===limb){ drag=null; creakStop(); tensionEl.style.display='none'; reattachCamera(); }
  limb.root.computeWorldMatrix(true);
  const wm = limb.root.getWorldMatrix();
  const s=V3(0,0,0), wq=new BABYLON.Quaternion(), wp=V3(0,0,0);
  wm.decompose(s,wq,wp);
  const tipLocal = V3(0, limb.tipExtent, 0);
  const tipWorld = BABYLON.Vector3.TransformCoordinates(tipLocal, wm);
  limb.root.setParent(null);
  limb.root.position.copyFrom(wp);
  limb.root.rotationQuaternion=wq; limb.root.scaling.set(1,1,1);
  limb.root.computeWorldMatrix(true);
  const tipNow = BABYLON.Vector3.TransformCoordinates(tipLocal, limb.root.getWorldMatrix());
  limb.root.position.addInPlace(tipWorld.subtract(tipNow));
  limb.stretch=1; limb.sVel=0; limb.throwV.set(0,0,0);
  const tang = V3(rnd(-1,1),0,rnd(-1,1)).scale(.8);
  limb.fly = { v: dir.scale(2.6).add(V3(0,1.6,0)).add(tang), av: V3(rnd(-4,4),rnd(-4,4),rnd(-4,4)) };
  limb.cap.setEnabled(true);
  cowboy.computeWorldMatrix(true);
  const socketW = BABYLON.Vector3.TransformCoordinates(limb.socketLocal, cowboy.getWorldMatrix());
  puffBurst(socketW); sfxPop(); stat.tears++; updStats(); updChips();
  shake=.5; shockT=1.6;
  damageJoe(8); /* травма от отрыва + проверка падения */
}
function reattach(limb, silent){
  limb.root.computeWorldMatrix(true);
  const s=V3(0,0,0), wq=new BABYLON.Quaternion(), wp=V3(0,0,0);
  limb.root.getWorldMatrix().decompose(s,wq,wp);
  limb.root.setParent(cowboy);
  limb.root.position.copyFrom(limb.socketLocal);
  cowboy.computeWorldMatrix(true);
  const pq = quatOf(cowboy.getWorldMatrix());
  limb.root.rotationQuaternion = BABYLON.Quaternion.Inverse(pq).multiply(wq);
  limb.snapFrom = limb.root.rotationQuaternion.clone(); limb.snapT=.35;
  limb.root.scaling.set(1,1,1); limb.stretch=.72; limb.sVel=3.5;
  limb.attached=true; limb.dragging=false; limb.fly=null; limb.throwV.set(0,0,0);
  limb.cap.setEnabled(false);
  if(drag===limb){ drag=null; creakStop(); tensionEl.style.display='none'; reattachCamera(); canvas.style.cursor='crosshair'; }
  if(!silent){ const socketW=BABYLON.Vector3.TransformCoordinates(limb.socketLocal, cowboy.getWorldMatrix());
    sewBurst(socketW); sfxSew(); stat.sewn++; updStats(); }
  updChips();
  healJoe(20); /* пришивание лечит */
}

/* ---------- главный цикл ---------- */
let prev=performance.now();
scene.onBeforeRenderObservable.add(()=>{
  const now=performance.now(); let dt=Math.min(.05,(now-prev)/1000); prev=now; time+=dt;

  /* трассеры и вспышки выстрелов */
  for(let i=tracers.length-1;i>=0;i--){
    const tr=tracers[i];
    tr.t += dt*70/tr.len;
    if(tr.t>=1){ tr.m.dispose(); tracers.splice(i,1); continue; }
    BABYLON.Vector3.LerpToRef(tr.a, tr.b, tr.t, tr.m.position);
  }
  for(let i=flashes.length-1;i>=0;i--){
    const fl=flashes[i];
    fl.t += dt*12;
    if(fl.t>=1){ fl.m.dispose(); flashes.splice(i,1); continue; }
    fl.m.scaling.setAll(.7+fl.t*2.6);
    fl.m.visibility = 1-fl.t;
  }
  if(flashT>0){
    flashT-=dt;
    flashLight.intensity = 2.4*Math.max(0,flashT)/.07;
    if(flashT<=0){ flashT=0; flashLight.setEnabled(false); }
  }

  /* перезарядка и прокрут барабана */
  if(reloading>0){
    reloading-=dt;
    if(reloading<=0){ reloading=0; ammo=6; updAmmo(); }
  }
  if(recoilT>0) recoilT=Math.max(0,recoilT-dt*4.5);
  if(drumSpinT>0) drumSpinT=Math.max(0,drumSpinT-dt);
  const spin = (drumSpinT>0?16:0)+(reloading>0?9:0);
  if(spin>0){
    drumWrap.rotationQuaternion = drumWrap.rotationQuaternion.multiply(BABYLON.Quaternion.RotationAxis(UP, spin*dt));
  }

  for(const limb of limbs){
    const root=limb.root;
    if(!limb.attached){
      if(limb.dragging){ /* несём оторванную деталь в руке */
        root.computeWorldMatrix(true);
        const tipOff=BABYLON.Vector3.TransformNormal(V3(0,limb.tipExtent,0), root.getWorldMatrix());
        const g = BABYLON.Vector3.TransformCoordinates(limb.grabOffsetLocal, root.getWorldMatrix());
        _scr.copyFrom(root.position);
        root.position.addInPlace(dragTarget.subtract(g));
        root.position.y = Math.max(root.position.y, .05 - Math.min(0, tipOff.y));
        if(dt>1e-4){
          const inst=root.position.subtract(_scr).scale(1/dt);
          BABYLON.Vector3.LerpToRef(limb.throwV, inst, .35, limb.throwV);
        }
        root.rotationQuaternion = BABYLON.Quaternion.Slerp(root.rotationQuaternion, limb.restQuat, 1-Math.exp(-5*dt));
        cowboy.computeWorldMatrix(true);
        const sock = BABYLON.Vector3.TransformCoordinates(limb.socketLocal, cowboy.getWorldMatrix());
        if(root.position.subtract(sock).length()<.5) reattach(limb);
      } else if(limb.fly){ /* физика полёта */
        const f=limb.fly;
        f.v.y-=9.8*dt;
        root.position.addInPlace(f.v.scale(dt));
        const dq=BABYLON.Quaternion.FromEulerAngles(f.av.x*dt,f.av.y*dt,f.av.z*dt);
        root.rotationQuaternion = dq.multiply(root.rotationQuaternion);
        root.computeWorldMatrix(true);
        const tipOff=BABYLON.Vector3.TransformNormal(V3(0,limb.tipExtent,0), root.getWorldMatrix());
        const low=Math.min(root.position.y, root.position.y+tipOff.y);
        if(low<limb.groundR){
          root.position.y += limb.groundR-low;
          f.v.x*=.7; f.v.z*=.7; f.av.scaleInPlace(.62);
          if(f.v.y<0) f.v.y = (-f.v.y>1.1) ? -f.v.y*.34 : 0;
        }
        if(f.v.lengthSquared()<.03 && f.av.lengthSquared()<.05){ f.v.setAll(0); f.av.setAll(0); }
      }
      continue;
    }
    if(limb.snapT>0){ limb.snapT-=dt; const k=clamp(1-limb.snapT/.35,0,1);
      root.rotationQuaternion = BABYLON.Quaternion.Slerp(limb.snapFrom, limb.restQuat, k*k*(3-2*k)); }
    if(limb.dragging){
      const A=worldPos(root);
      const v=dragTarget.subtract(A); const dist=v.length();
      const dir = dist>1e-4 ? v.scale(1/dist) : limb.axis;
      limb.stretchTarget = clamp(dist/limb.reach, .85, limb.threshold+.3);
      const q = aimQuat(dir, limb.twistFix, limb.axis);
      root.rotationQuaternion = BABYLON.Quaternion.Slerp(root.rotationQuaternion, q, 1-Math.exp(-16*dt));
      limb.curDir = dir;
    } else {
      limb.stretchTarget=1;
      const sway = BABYLON.Quaternion.RotationAxis(V3(0,0,1), Math.sin(time*1.1+limb.phase)*limb.swayAmp);
      root.rotationQuaternion = BABYLON.Quaternion.Slerp(root.rotationQuaternion, limb.restQuat.multiply(sway), 1-Math.exp(-8*dt));
    }
    limb.sVel += (limb.stretchTarget-limb.stretch)*160*dt;
    limb.sVel *= Math.max(0,1-14*dt);
    limb.stretch += limb.sVel*dt;
    const sy = clamp(limb.stretch,.5,3.2);
    const rs = clamp(1/Math.sqrt(sy),.62,1.25);
    root.scaling.set(rs, sy, rs);
    for(const [n,base] of limb.bendNodes) n.rotation.x = base*clamp(1-(limb.stretch-1)*1.9,0,1);
    if(limb.dragging && limb.stretch>=limb.threshold) tear(limb, limb.curDir||limb.axis);
    if(limb.dragging && limb.attached){
      creakUpdate(limb.stretch);
      const pct=clamp(limb.stretch/limb.threshold,0,1);
      tFill.style.width=(pct*100)+'%';
      tensionEl.className='hud tension'+(pct>.85?' danger':pct>.6?' warn':'');
    }
  }

  /* наклон корпуса */
  let lx=0,lz=0;
  if(drag && drag.attached){
    const A=worldPos(drag.root); const v=dragTarget.subtract(A);
    const h=Math.hypot(v.x,v.z);
    if(h>.01){ const amt=Math.min(.13, Math.max(0,drag.stretch-1)*.11+.015);
      lx=(v.z/h)*amt; lz=-(v.x/h)*amt; }
  }
  lean.x+=(lx-lean.x)*(1-Math.exp(-6*dt)); lean.z+=(lz-lean.z)*(1-Math.exp(-6*dt));
  cowboy.rotation.y=Math.sin(time*.6)*.02*(drag?0:1);

  /* опрокидывание / подъём */
  const kFall = downTarget>downAmt ? 5.5 : 3.0;
  downAmt += (downTarget-downAmt)*(1-Math.exp(-kFall*dt));
  if(downAmt>.002){
    cowboy.position.y = .24*downAmt;
    cowboy.rotation.x = lean.x + (-1.52-lean.x)*downAmt;
    cowboy.rotation.z = lean.z*(1-downAmt) + .14*downAmt;
    if(downAmt>.85 && !downPlayed){
      downPlayed=true; sfxThud(); shake=Math.max(shake,.7);
      puffBurst(V3(0,.15,-.85)); dustBurst(V3(.35,.12,-1.1)); dustBurst(V3(-.3,.12,-1.0));
    }
  } else { cowboy.position.y=0; cowboy.rotation.x=lean.x; cowboy.rotation.z=lean.z; }
  if(downAmt<.3) downPlayed=false;

  /* дыхание (мёртвый не дышит) */
  const br=1+.02*Math.sin(time*1.7);
  chest.scaling.set(hp>0?br:1,.86,.72*(hp>0?br:1));

  /* взгляд и моргание */
  const head=limbs[0];
  if(head.attached && !dead){
    const hp2=worldPos(head.root).add(V3(0,.24,0));
    const lookAt = drag ? dragTarget : camera.position;
    const dirW = lookAt.subtract(hp2).normalize();
    const invQ=head.root.rotationQuaternion.clone(); invQ.conjugateInPlace();
    const mInv=BABYLON.Matrix.Identity();
    BABYLON.Matrix.FromQuaternionToRef(invQ, mInv);
    const local=BABYLON.Vector3.TransformCoordinates(dirW, mInv);
    for(const p of pupils){ p.m.position.x=p.bx+clamp(local.x,-1,1)*.013; p.m.position.y=p.by+clamp(local.y,-1,1)*.009; }
  }
  blinkNext-=dt;
  if(blinkNext<0){ blinkT=.13; blinkNext=rnd(2.5,5.5); }
  if(blinkT>0){ blinkT-=dt; pupils.forEach(p=>p.m.scaling.y=.15); } else pupils.forEach(p=>p.m.scaling.y=1);
  if(dead){ pupils.forEach(p=>p.m.scaling.y=.12); }
  if(shockT>0){ shockT-=dt; mouthO.isVisible=true;
    brows.forEach(b=>b.m.position.y=b.by+.02); eyes.forEach(e=>e.scaling.set(1.15,1.15,.55));
    if(shockT<=0){ mouthO.isVisible=false; brows.forEach(b=>b.m.position.y=b.by); eyes.forEach(e=>e.scaling.set(1,1,.55)); } }

  /* лагерь: огонь, Билл и сосиска */
  campAnim.fireLight.intensity = 1.0 + Math.sin(time*9.3)*.22 + Math.sin(time*21.7)*.11 + Math.sin(time*3.7)*.15;
  const es = 1 + .08*Math.sin(time*8.2);
  campAnim.ember.scaling.set(es, .55*(1+.12*Math.sin(time*6.3)), es);
  campAnim.chest.scaling.set(1.02*(1+.03*Math.sin(time*1.5+campAnim.phase)), .82, .86);
  campAnim.head.rotation.x = .14 + Math.sin(time*.6+campAnim.phase)*.06;
  campAnim.head.rotation.y = Math.sin(time*.23+campAnim.phase)*.3;
  campAnim.stick.rotation.x = Math.sin(time*.9+campAnim.phase)*.04;
  campAnim.stick.rotation.z = Math.sin(time*.6)*.025;
  /* вертел: вращение вокруг оси прутика (локальная Y узла) */
  campAnim.grill.rotationQuaternion = campAnim.grill.rotationQuaternion.multiply(BABYLON.Quaternion.RotationAxis(UP, dt*1.4));
  if(Math.random()<dt*.25) greasePop(campAnim.sw);
  campAnim.bNext-=dt;
  if(campAnim.bNext<0){ campAnim.bT=.12; campAnim.bNext=rnd(2,6); }
  if(campAnim.bT>0){ campAnim.bT-=dt; campAnim.eyes.forEach(e=>e.scaling.y=.12); }
  else campAnim.eyes.forEach(e=>e.scaling.y=1);

  /* viewmodel-револьвер: отдача и покачивание
     (наклон задаём rotFromTo — гарантированно «дуло вверх» при отдаче) */
  const gx=Math.sin(time*.8)*.02;
  const gy=.40*recoilT + Math.sin(time*1.7)*.012;
  gunRoot.position.set(GUN_BASE.x, GUN_BASE.y+Math.sin(time*1.15)*.006, GUN_BASE.z-.075*recoilT);
  gunRoot.rotationQuaternion = rotFromTo(FWD, V3(gx, gy, 1).normalize());

  /* tumbleweed */
  const tw=(time*.9)%30; tumble.position.set(-15+tw, .3+Math.abs(Math.sin(time*2.3))*.22, 3.4+Math.sin(time*.4)*1.4);
  tumble.rotation.x-=dt*3.2; tumble.rotation.z-=dt*1.1;

  /* камера */
  if(introT<2){ introT+=dt; camera.radius+=(4.6-camera.radius)*(1-Math.exp(-2*dt)); }
  idleT+=dt;
  if(idleT>8 && !drag) camera.alpha+=dt*.1;
  if(shake>0){ shake=Math.max(0,shake-dt*1.6); camera.alpha+=rnd(-1,1)*shake*.012; camera.beta+=rnd(-1,1)*shake*.012; }
  if(focusT>0){ focusT-=dt; if(focusPos) camera.setTarget(BABYLON.Vector3.Lerp(camera.target, focusPos, .08));
    if(focusT<=0){ camera.setTarget(V3(0,1.02,0)); focusPos=null; } }

  if(stat.pulls===0 && stat.shots===0 && !drag && !hoverLimb) setHint((time%1.7)<.75); else setHint(false);
});

engine.runRenderLoop(()=>scene.render());
window.addEventListener('resize',()=>engine.resize());
</script>
