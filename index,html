let hp=100, dead=false, downAmt=0, downTarget=0, downPlayed=false;
function setMood(){
  let m;
  if(dead) m='☠ Джо пал в неравном бою…';
  else if(downTarget>.5||downAmt>.5)
    m=(!limbLegL.attached||!limbLegR.attached)?'Без опоры: Джо на земле':'Джо сбит с ног';
  else if(hp>70) m='Джо в отличной форме';
  else if(hp>40) m='Джо держится молодцом';
  else if(hp>15) m='Джо ранен, но стоит';
  else m='Джо на последних силах';
  moodEl.textContent=m;
}
