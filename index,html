function M(builder, material, pos, opt={}){
  const m = builder(); m.material = material; m.position.set(pos[0],pos[1],pos[2]);
  if(opt.s) m.scaling.set(opt.s[0],opt.s[1],opt.s[2]);
  if(opt.r) m.rotation.set(opt.r[0],opt.r[1],opt.r[2]);
  m.parent = opt.parent || cowboy;
  m.receiveShadows=true;
  /* торс (parent не null) пикается для урона; меши конечностей станут
     пикаемыми в makeLimb */
  if(opt.parent !== null){ m.isPickable = true; bodyMeshes.add(m); }
  else m.isPickable = false;
  shGen.addShadowCaster(m); return m;
}
