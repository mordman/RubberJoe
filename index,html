let AC=null, master=null, creak=null, muted=false;
function wakeAudio(){ if(AC) { if(AC.state==='suspended') AC.resume(); return; }
  AC = new (window.AudioContext||window.webkitAudioContext)();
  master = AC.createGain(); master.gain.value = muted?0:.5; master.connect(AC.destination); }
function creakStart(){ if(!AC||muted||creak) return;
  const o=AC.createOscillator(), f=AC.createBiquadFilter(), g=AC.createGain();
  o.type='sawtooth'; o.frequency.value=70; f.type='lowpass'; f.frequency.value=420; f.Q.value=4;
  g.gain.setValueAtTime(0.0001,AC.currentTime); g.gain.exponentialRampToValueAtTime(.05,AC.currentTime+.1);
  o.connect(f); f.connect(g); g.connect(master); o.start(); creak={o,f,g}; }
function creakUpdate(s){ if(!creak) return; const t=AC.currentTime;
  creak.o.frequency.setTargetAtTime(clamp(60+(s-1)*150,50,420),t,.05);
  creak.f.frequency.setTargetAtTime(300+s*260,t,.05);
  creak.gain.setTargetAtTime(clamp(.02+(s-1)*.08,.02,.09),t,.05); }
function creakStop(){ if(!creak) return; const c=creak; creak=null;
  c.g.gain.setTargetAtTime(.0001,AC.currentTime,.05); c.o.stop(AC.currentTime+.25); }
function sfxPop(){ if(!AC||muted) return; const t=AC.currentTime;
  const o=AC.createOscillator(), g=AC.createGain(); o.type='triangle';
  o.frequency.setValueAtTime(320,t); o.frequency.exponentialRampToValueAtTime(60,t+.13);
  g.gain.setValueAtTime(.4,t); g.gain.exponentialRampToValueAtTime(.001,t+.16);
  o.connect(g); g.connect(master); o.start(t); o.stop(t+.18);
  const buf=AC.createBuffer(1,Math.floor(AC.sampleRate*.12),AC.sampleRate), d=buf.getChannelData(0);
  for(let i=0;i<d.length;i++) d[i]=(Math.random()*2-1)*(1-i/d.length);
  const n=AC.createBufferSource(), nf=AC.createBiquadFilter(), ng=AC.createGain();
  n.buffer=buf; nf.type='bandpass'; nf.frequency.value=900; ng.gain.value=.3;
  n.connect(nf); nf.connect(ng); ng.connect(master); n.start(t); }
function sfxSew(){ if(!AC||muted) return; const t=AC.currentTime;
  [620,930].forEach((f,i)=>{ const o=AC.createOscillator(), g=AC.createGain(); o.type='square';
    o.frequency.value=f; g.gain.setValueAtTime(.1,t+i*.08); g.gain.exponentialRampToValueAtTime(.001,t+i*.08+.07);
    o.connect(g); g.connect(master); o.start(t+i*.08); o.stop(t+i*.08+.09); }); }
function sfxShot(){ if(!AC||muted) return; const t=AC.currentTime;
  const len=Math.floor(AC.sampleRate*.18);
  const buf=AC.createBuffer(1,len,AC.sampleRate), d=buf.getChannelData(0);
  for(let i=0;i<len;i++){ const k=1-i/len; d[i]=(Math.random()*2-1)*k*k; }
  const src=AC.createBufferSource(); src.buffer=buf;
  const f=AC.createBiquadFilter(); f.type='lowpass';
  f.frequency.setValueAtTime(3400,t); f.frequency.exponentialRampToValueAtTime(220,t+.16);
  const g=AC.createGain(); g.gain.setValueAtTime(.9,t); g.gain.exponentialRampToValueAtTime(.001,t+.18);
  src.connect(f); f.connect(g); g.connect(master); src.start(t);
  const o=AC.createOscillator(), og=AC.createGain(); o.type='triangle';
  o.frequency.setValueAtTime(190,t); o.frequency.exponentialRampToValueAtTime(46,t+.12);
  og.gain.setValueAtTime(.5,t); og.gain.exponentialRampToValueAtTime(.001,t+.14);
  o.connect(og); og.connect(master); o.start(t); o.stop(t+.16); }
function sfxHit(){ if(!AC||muted) return; const t=AC.currentTime;
  const o=AC.createOscillator(), g=AC.createGain(); o.type='triangle';
  o.frequency.setValueAtTime(240,t); o.frequency.exponentialRampToValueAtTime(80,t+.09);
  g.gain.setValueAtTime(.35,t); g.gain.exponentialRampToValueAtTime(.001,t+.11);
